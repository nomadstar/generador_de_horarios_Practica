dColor: \"#FFDA27\",\n                padding: \"0px\",\n                borderStyle: \"solid\",\n                borderWidth: \"1px\",\n                borderRadius: \"5px\",\n              }}\n            >\n              <br />\n            </Card>\n          </Col>\n          <Col span={8}>Formación en Ingeniería Aplicada</Col>\n          <Col span={3}></Col>\n        </Row>\n        <Row>\n          <Col span={3}></Col>\n          <Col span={1}>\n            <Card\n              bodyStyle={{\n                backgroundColor: \"#ffffff\",\n                padding: \"0px\",\n                borderStyle: \"solid\",\n                borderWidth: \"1px\",\n                borderRadius: \"5px\",\n              }}\n            >\n              <br />\n            </Card>\n          </Col>\n          <Col span={8}>Prácticas I y II</Col>\n          <Col span={1}>*</Col>\n          <Col span={8}>\n            (Electivos 33XX: Área Informática / Electivos 34XX: Área\n            Telecomuniaciones)\n          </Col>\n          <Col span={3}></Col>\n        </Row>\n        <br />\n        <br />\n        <Row\n          gutter={[\n            { xs: 2, sm: 4, md: 6, lg: 12 },\n            { xs: 2, sm: 4, md: 6, lg: 12 },\n          ]}\n          justify=\"center\"\n        >\n          <Col xs={12} sm={8} md={6} lg={4} xl={3} xxl={2}>\n            <Semestre semestre={\"1\"} />\n            <br />\n            <Ramo\n              codigo={\"CBM-1000\"}\n              ramo={\"Álgebra y Geometría\"}\n              color={\"#45C8FF\"}\n              id={\"1\"}\n              req={\"-\"}\n            />\n            <Ramo\n              codigo={\"CBM-1001\"}\n              ramo={\"Cálculo I\"}\n              color={\"#45C8FF\"}\n              id={\"2\"}\n              req={\"-\"}\n            />\n            <Ramo\n              codigo={\"CBQ-1000\"}\n              ramo={\"Química\"}\n              color={\"#45C8FF\"}\n              id={\"3\"}\n              req={\"-\"}\n        