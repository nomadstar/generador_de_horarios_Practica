ge\n                  width={\"60%\"}\n                  src={`https://cdn.discordapp.com/attachments/928022489039273994/933606606548107294/udp.png`}\n                  preview=\"false\"\n                />\n              </Col>\n              <Col xs={24} style={{ textAlign: \"center\" }}>\n                <Title\n                  style={{\n                    fontSize: \"50px\",\n                  }}\n                >\n                  ¡Bienvenido al Asistente Toma de Ramos!\n                </Title>\n                <Title level={3} type=\"secondary\">\n                  Esta plataforma tiene como objetivo asistir a los estudiantes\n                  de la UDP en su proceso de toma de ramos. ¡Suerte!\n                </Title>\n              </Col>\n            </Row>\n          </ATRLayout>\n        ) : (\n          <NotAuth />\n        )}\n      </Fragment>\n    );\n  }\n}\n","/home/ignatus/Documentos/Github/GA_Proyect/horarios/src/components/SubirOfertas.js",[],"/home/ignatus/Documentos/Github/GA_Proyect/horarios/src/components/Mallas.js",[],"/home/ignatus/Documentos/Github/GA_Proyect/horarios/src/components/Usuarios.js",[],"/home/ignatus/Documentos/Github/GA_Proyect/horarios/src/components/M2018.js",[],"/home/ignatus/Documentos/Github/GA_Proyect/horarios/src/components/M2020.js",[],"/home/ignatus/Documentos/Github/GA_Proyect/horarios/src/components/M2010Extra2.js",["437"],"import React, { Component, Fragment } from \"react\";\nimport ATRLayout from \"./Layout\";\nimport Malla2010Extra2 from \"./Malla2010Extra2\";\nimport { Button, Typography, Row, Col } from \"antd\";\nimport {\n  ArrowLeftOutlined,\n  ArrowRightOutlined,\n  PlusCircleTwoTone,\n} from \"@ant-design/icons\";\nimport \"antd/dist/antd.css\";\nimport \"../assets/css/Buttons.css\";\n\nconst { Title } = Typography;\n\nexport default class M2010Extra2 extends Component {\n  render() {\n    return (\n      <Fragment>\n        <ATRLayout phase={1}>\n          <Row\n            gutter={[\n           